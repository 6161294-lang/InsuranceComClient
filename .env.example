# Optional. Where the dev server proxies /api requests (default http://localhost:5080, the API from InsuranceComServer).
API_PROXY_TARGET=http://localhost:5080

# Required for a deployed build (Render, any static host): absolute URL of the API, no trailing slash.
# The API must list this site's origin in its Cors__AllowedOrigins setting.
# VITE_API_URL=https://your-api.onrender.com
